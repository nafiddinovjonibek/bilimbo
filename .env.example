# Narakeet hisobingizdagi API kalitini .env fayliga kiriting.
NARAKEET_API_KEY=

# Odina tanlangan. MP3 fayllar yaratilguncha mavjud Madina yozuvlari ijro etiladi.
BILIMBO_TTS_VOICE=odina
BILIMBO_TTS_RATE=+0%

# Mahalliy ishga tushirish. Serverda false qilib, maxfiy kalit va domenni kiriting.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Kitoblar uchun yopiq papka; bo'sh qoldirish o'rniga kerak bo'lmasa qatorni yozmang.
# PRIVATE_BOOKS_ROOT=D:/private/bilimbo-books
# PRIVATE_VOICES_ROOT=D:/private/bilimbo-voices
